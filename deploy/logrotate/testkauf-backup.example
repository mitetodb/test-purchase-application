# Example only. Not installed by this repository.
# After review, copy to /etc/logrotate.d/testkauf-backup (mode 644).
# copytruncate: backup-mysql.sh and backup-uploads.sh append to this file
# and there is no daemon to signal. Do not add a mail directive; prod has no mailer.
/var/log/testkauf-backup.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 640 root adm
}
