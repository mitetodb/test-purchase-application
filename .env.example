# Copy to deploy/.env (prod) or .env (local) and fill in. NEVER commit the real file.
# Generate secrets with: openssl rand -base64 32

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
DB_NAME=test_purchase_db
DB_USERNAME=testpurchase
DB_PASSWORD=change-me
PRICING_DB_NAME=pricedb
PRICING_DB_USERNAME=priceuser
PRICING_DB_PASSWORD=change-me

# --- pricing microservice (must equal PRICING_API_KEY of price-calculation-microservice) ---
PRICING_API_KEY=change-me
# PRICING_API_BASE_URL=http://pricing-svc:8081
# Build context of the sibling repo (or set PRICING_IMAGE to a prebuilt image)
PRICING_BUILD_CONTEXT=../../price-calculation-microservice
# PRICING_IMAGE=ghcr.io/mitetodb/price-calculation-microservice:latest

# --- app ---
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=https://testkauf.getinweb.de
# Initial admin is only created when the users table is empty AND this is set.
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=testkauf@getinweb.de
DEMO_DATA_ENABLED=false
# with DEMO_DATA_ENABLED=true: seed N demo test purchases (Samsung/LG/Apple, DE/AT shops, all statuses). 0 = off
DEMO_PURCHASES=0
# Opt-in demo users per role (random passwords, set them out of band)
DEMO_USERS=false
# Base64-encoded 32-byte AES key for encrypting TOTP secrets at rest (openssl rand -base64 32)
APP_TOTP_ENCRYPTION_KEY=change-me
# APP_TOTP_ISSUER=Test Purchase
SWAGGER_ENABLED=false
# Host port the host proxy forwards to (bound to 127.0.0.1 only)
APP_HOST_PORT=8090

# --- mail (optional). Off by default: MAIL_ENABLED=false -> emails are logged and skipped. ---
# ALL-INKL (kasserver). Hetzner Cloud blocks outbound 465 by default -> 587 STARTTLS (verified on baccardi).
# Elsewhere 465 SSL works too: MAIL_PORT=465 MAIL_SSL=true MAIL_STARTTLS=false
MAIL_ENABLED=false
MAIL_HOST=w00d37b3.kasserver.com
MAIL_PORT=587
MAIL_SSL=false
MAIL_STARTTLS=true
MAIL_SMTP_AUTH=true
MAIL_USERNAME=your-kas-mailbox-login
MAIL_PASSWORD=change-me
MAIL_FROM=testkauf@getinweb.de
# Shop visit appointment notifications (issue #24). Default off — enable only when Dimitar opts in (requires MAIL_ENABLED=true too).
MAIL_VISIT_APPOINTMENT_ENABLED=false
# Local dev with Mailpit instead: MAIL_HOST=mailpit MAIL_PORT=1025 MAIL_SSL=false MAIL_SMTP_AUTH=false

# --- deadline reminder e-mails (issue #16). Off by default; requires MAIL_ENABLED=true as well. ---
# Compose forwards these into the app container and defaults them off (application.properties).
# DEADLINE_REMINDER_ENABLED=false
# DEADLINE_REMINDER_DAYS_BEFORE=7,1,0
# DEADLINE_REMINDER_CRON=0 0 8 * * ?

# --- monitoring for health.getinweb.de (issue #18). Alerts off by default; no outbound calls until enabled. ---
# Compose forwards these keys. Defaults match application.properties (checks and alerts off).
# Paths are inside the app container. Host files are not mounted unless the commented
# read-only volume examples in deploy/docker-compose.prod.yml are uncommented on the server.
# MONITORING_BACKUP_CHECK_ENABLED=false
# MONITORING_BACKUP_MARKER_PATH=/var/lib/testkauf/backup-last-success.timestamp
# MONITORING_BACKUP_SCAN_DIRECTORY=/var/lib/testkauf/backup-scan
# MONITORING_BACKUP_MAX_AGE_HOURS=26
# MONITORING_SERVER_ERROR_WINDOW_SECONDS=300
# MONITORING_SERVER_ERROR_THRESHOLD=20
# MONITORING_ALERT_ENABLED=false
# MONITORING_ALERT_WEBHOOK_URL=
# MONITORING_ALERT_EMAIL_TO=
# MONITORING_ALERT_CRON=0 */5 * * * ?
